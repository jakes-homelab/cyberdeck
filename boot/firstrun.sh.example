#!/bin/bash
# cyberdeck first-boot script — TEMPLATE.
#
# Copy to boot/firstrun.sh, fill in the placeholders, and drop it on the FAT boot
# partition of a freshly flashed stock Raspberry Pi OS card. This is the same
# mechanism Raspberry Pi Imager's customization uses. Reference it by appending to
# cmdline.txt on the boot partition:
#
#   systemd.run=/boot/firstrun.sh systemd.run_success_action=reboot systemd.unit=kernel-command-line.target
#
# It does the MINIMUM to let Ansible take over: a login user with your SSH key,
# SSH enabled, and WiFi. Everything else is a role. It carries WiFi + SSH material,
# so boot/firstrun.sh is gitignored and NEVER committed.
#
# No secret in this repo: the real values live only in your local copy.
set -euo pipefail

# --- Fill these in -------------------------------------------------------------
DEVICE_USER="deck"                      # must match device_user in config.yml
DEVICE_USER_PUBKEY="ssh-ed25519 AAAA...replace-with-your-public-key... you@example"
HOSTNAME="cyberdeck"
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
WIFI_COUNTRY="US"                       # ISO 3166-1 alpha-2; required for WiFi to come up
# -------------------------------------------------------------------------------

# Hostname
echo "${HOSTNAME}" >/etc/hostname
sed -i "s/127.0.1.1.*/127.0.1.1\t${HOSTNAME}/" /etc/hosts || true

# User + SSH key (key-only; base role later disables password auth)
if ! id -u "${DEVICE_USER}" >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo "${DEVICE_USER}"
fi
install -d -m 0700 -o "${DEVICE_USER}" -g "${DEVICE_USER}" "/home/${DEVICE_USER}/.ssh"
echo "${DEVICE_USER_PUBKEY}" >"/home/${DEVICE_USER}/.ssh/authorized_keys"
chmod 0600 "/home/${DEVICE_USER}/.ssh/authorized_keys"
chown "${DEVICE_USER}:${DEVICE_USER}" "/home/${DEVICE_USER}/.ssh/authorized_keys"
echo "${DEVICE_USER} ALL=(ALL) NOPASSWD:ALL" >"/etc/sudoers.d/010_${DEVICE_USER}-nopasswd"
chmod 0440 "/etc/sudoers.d/010_${DEVICE_USER}-nopasswd"

# Enable SSH
systemctl enable ssh
touch /boot/ssh || true

# WiFi via wpa_supplicant (works on stock Raspberry Pi OS)
cat >/etc/wpa_supplicant/wpa_supplicant.conf <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=${WIFI_COUNTRY}

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PASSWORD}"
}
EOF
chmod 0600 /etc/wpa_supplicant/wpa_supplicant.conf
rfkill unblock wifi || true

# Clean up: remove self from cmdline so this only runs once.
sed -i 's| systemd.run=/boot/firstrun.sh[^ ]*||g; s| systemd.run_success_action=reboot||g; s| systemd.unit=kernel-command-line.target||g' /boot/cmdline.txt || true
rm -f /boot/firstrun.sh || true

exit 0
